# Financeiro Raio-X — external Supabase deployment example.
# Copy to your hosting provider's secret/environment configuration.
# NEVER commit a populated .env file, JWT, database password or service_role/secret key.

# Public build-time settings (Vite client)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Server-only settings for auth middleware, routes and server functions
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Do not use SUPABASE_SECRET_KEY as a substitute for SUPABASE_SERVICE_ROLE_KEY:
# current server code reads SUPABASE_SERVICE_ROLE_KEY.
# Keep client/server URLs on the SAME Supabase project to avoid invalid JWTs.
